<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: la app usa cifrado estándar propio (X25519 + HKDF-SHA256 +
	     AES-GCM en HelpCrypto.swift) y NO está exenta de la Nota 4 (Cat. 5 Parte 2 EAR),
	     porque incluye chat E2E. Clasificación: 5D992.c, autoclasificación mass-market
	     §742.15(b)(1). Ver docs/Export-Compliance-Cifrado.md

	     NO volver a poner ITSAppUsesNonExemptEncryption aquí. Puesto en el commit
	     970403e, provocó el rechazo ITMS-90592 en los builds 78 y 79 (2026-08-24):
	     con esa key a YES Apple exige también ITSEncryptionExportComplianceCode y
	     rechaza la entrega al no encontrarlo. La declaración se hace en App Store
	     Connect, por build, que es donde Apple la espera. -->
	<!-- Precisión reducida a nivel de sistema (~1-3 km) para la ubicación del
	     ayudante. No basta con redondear en el servidor: así la minimización
	     deja de ser una promesa nuestra y pasa a ser una restricción que impone
	     iOS y que el ayudante puede comprobar. Además permite declarar Coarse
	     Location —y no Precise— en la ficha de privacidad de App Store.
	     Para calcular rutas se pide precisión completa puntualmente, con
	     requestTemporaryFullAccuracyAuthorization. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<!-- Precisión completa temporal, solo para guiar paso a paso. Con la
	     precisión reducida por defecto (1-3 km) la navegación no serviría, y
	     es la función principal para el usuario con discapacidad. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>Navegacion</key>
		<string>Para guiarte paso a paso durante el trayecto, Wheelp necesita tu ubicación exacta mientras dura la ruta.</string>
	</dict>
	<key>NSServices</key>
	<array>
		<dict/>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Wheelp necesita la cámara para escanear tu documento de identidad y verificar tu identidad como ayudante.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Wheelp necesita el micrófono para la comprobación de prueba de vida durante la verificación de identidad.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Puedes subir una foto de tu documento desde la galería en vez de usar la cámara.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fastavan.wheelp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wheelp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
