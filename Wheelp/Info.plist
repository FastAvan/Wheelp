<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance: la app usa cifrado estándar propio (X25519 + HKDF-SHA256 +
	     AES-GCM en HelpCrypto.swift) y NO está exenta de la Nota 4 (Cat. 5 Parte 2 EAR),
	     porque incluye chat E2E. FALTA ITSEncryptionExportComplianceCode: Apple lo emite
	     tras subir la documentación de export compliance en App Store Connect.
	     Detalle y pasos pendientes en docs/Export-Compliance-Cifrado.md -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>NSServices</key>
	<array>
		<dict/>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Wheelp necesita la cámara para escanear tu documento de identidad y verificar tu identidad como ayudante.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Wheelp necesita el micrófono para la comprobación de prueba de vida durante la verificación de identidad.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Puedes subir una foto de tu documento desde la galería en vez de usar la cámara.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>fastavan.wheelp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wheelp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
