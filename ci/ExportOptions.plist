<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<!-- La exportación sube directamente a App Store Connect: sin este destino
	     habría que encadenar altool y manejar el .ipa a mano. -->
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>967AMV9QSH</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Firma manual con la identidad que el job importa en un llavero temporal.
	     Automática pediría un certificado nuevo a Apple en cada ejecución. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>fastavan.wheelp</key>
		<string>Wheelp App Store CI</string>
	</dict>
</dict>
</plist>
